// The share extension: text, links, pictures and PDFs from the share sheet, left in the App Group for the app to
// write into a new note or the end of the note opened last. It is built with the app and goes inside it.
#include "Shared.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(NOTEBOOK_BUNDLE_IDENTIFIER).Share

// The App Group wherever the app has it (Shared.xcconfig); on the Mac the sandbox in every build.
NOTEBOOK_SHARE_MAC_ENTITLEMENTS = Config/Extension-macOS.entitlements
NOTEBOOK_SHARE_MAC_ENTITLEMENTS[config=AppStore] = Config/Share-macOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = $(NOTEBOOK_SHARE_MAC_ENTITLEMENTS)
NOTEBOOK_SHARE_IOS_ENTITLEMENTS =
NOTEBOOK_SHARE_IOS_ENTITLEMENTS[sdk=iphonesimulator*] = Config/AppGroup.entitlements
NOTEBOOK_SHARE_IOS_ENTITLEMENTS[config=AppStore] = Config/AppGroup.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = $(NOTEBOOK_SHARE_IOS_ENTITLEMENTS)
