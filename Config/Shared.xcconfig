// Settings shared by every build. Personal settings (your signing team) go in Local.xcconfig,
// which is not checked in.

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// The app's bundle identifier; its extensions' start with it (Widgets.xcconfig). A build of your own takes another
// with NOTEBOOK_BUNDLE_IDENTIFIER=com.example.Notebook on the command line. PRODUCT_BUNDLE_IDENTIFIER there would give
// the extensions the app's identifier too, which the build refuses.
NOTEBOOK_BUNDLE_IDENTIFIER = com.lukaskbl.Notebook
PRODUCT_BUNDLE_IDENTIFIER = $(NOTEBOOK_BUNDLE_IDENTIFIER)

// The App Group in which the share extension leaves what is shared, for the app to write into the notes (SharedNotes
// in NotebookCapture). The App Store build has it, and so do builds for the Simulator, which need no team for it. In
// other builds the share extension can't keep anything, and the app never looks in a group's folder: on the Mac that
// would ask you for access to other apps' data.
NOTEBOOK_APP_GROUP =
NOTEBOOK_APP_GROUP[config=AppStore] = group.com.lukaskbl.Notebook
NOTEBOOK_APP_GROUP[sdk=iphonesimulator*] = group.com.lukaskbl.Notebook

// Notebook uses no encryption of its own (iCloud and HTTPS are Apple's), so App Store Connect doesn't ask about export
// compliance for every build.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

// Without a team the Mac app is signed to run on this Mac only, and the iPhone and iPad app runs in the Simulator,
// which is all a local build needs. To run it on your own iPhone or iPad, set your team in Local.xcconfig.
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Development

// Debug and Release run without the sandbox, so tests can point the app at any folder. The App Store build is
// sandboxed and reaches folders through the bookmarks of the locations you add, and may ask where you are, for a
// reminder's Current Location. It also has iCloud's key-value store,
// which takes the folders you hide and your reminders to your other devices, Notebook's own iCloud folder
// (iCloud.$(CFBundleIdentifier)), whose History folder takes the earlier versions of your notes in iCloud there too,
// and Time Sensitive notifications, which get reminders through a Focus. The other builds keep hidden folders,
// reminders and versions on this Mac, the versions in Application Support.
NOTEBOOK_MAC_ENTITLEMENTS =
NOTEBOOK_MAC_ENTITLEMENTS[config=AppStore] = Config/Notebook-macOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = $(NOTEBOOK_MAC_ENTITLEMENTS)

// On iPhone and iPad too, only the App Store build has iCloud's key-value store, Notebook's iCloud folder and Time
// Sensitive notifications. Debug and Release keep the folders you hide, your reminders and the versions of your notes
// on the device, so they run in the Simulator without a team, and on your own iPhone or iPad with a free one, which
// can't have iCloud. In the Simulator they have the App Group.
NOTEBOOK_IOS_ENTITLEMENTS =
NOTEBOOK_IOS_ENTITLEMENTS[config=Debug][sdk=iphonesimulator*] = Config/AppGroup.entitlements
NOTEBOOK_IOS_ENTITLEMENTS[config=Release][sdk=iphonesimulator*] = Config/AppGroup.entitlements
NOTEBOOK_IOS_ENTITLEMENTS[config=AppStore] = Config/Notebook-iOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = $(NOTEBOOK_IOS_ENTITLEMENTS)

#include? "Local.xcconfig"
