# Releases Notebook to the App Store and TestFlight, for the Mac, iPhone and iPad.
#
# Every call to App Store Connect signs in with an App Store Connect API key (.p8), so there are no Apple ID or
# two-factor prompts, and Xcode needs no account; store_signing below says how the builds are signed. Copy
# fastlane/.env.secret.example to fastlane/.env.secret (it is gitignored) and fill it in, run `bundle install` once,
# and then:
#
#   bundle exec fastlane screenshots   # take the App Store screenshots of the iPhone, iPad and Mac apps
#   bundle exec fastlane metadata      # upload the texts, the age rating and the screenshots of both platforms
#                                      # (screenshots:false leaves the ones in App Store Connect as they are)
#   bundle exec fastlane build         # build the Mac, iPhone and iPad apps for the App Store, without uploading
#   bundle exec fastlane beta          # build the Mac, iPhone and iPad apps and upload them to TestFlight
#   bundle exec fastlane submit        # submit the builds uploaded by `beta` for review, after testing them
#   bundle exec fastlane release       # build them, upload everything and submit both platforms for review
#   bundle exec fastlane store_media   # check the header, search result and app previews (upload:true uploads them)
#
# `bundle exec fastlane ios <lane>` and `bundle exec fastlane mac <lane>` do one platform. The texts are in
# fastlane/metadata and the screenshots in Design/screenshots/app-store. Design/app-store.md lists what has to be set
# once in App Store Connect itself.
#
# .github/workflows/testflight.yml runs `ios beta` and `mac beta` on GitHub for every change to the app on main.
# TestFlight builds are numbered as beta_version and build_number below say: 1.0.0 (2026.1017.1047).
# So a release goes: set its version in Config/Shared.xcconfig, let `beta` build it, `submit`, and tag it after.

require "fileutils"
require "plist"
require "shellwords"
require_relative "asset_library"

# The texts and build settings are UTF-8 ("›", "•", "⌘"), whatever the shell's locale is.
Encoding.default_external = Encoding::UTF_8
ENV["LANG"] = "en_US.UTF-8" if ENV["LANG"].to_s.empty?
ENV["LC_ALL"] = "en_US.UTF-8" if ENV["LC_ALL"].to_s.empty?

APP_ID = "com.lukaskbl.Notebook"
# Notebook's own iCloud folder, where version history keeps the copies of notes in iCloud (the entitlements say
# iCloud.$(CFBundleIdentifier)).
ICLOUD_CONTAINER = "iCloud.#{APP_ID}"
# The app and the extensions inside it, by the names of their targets. Each has a bundle identifier of its own, which
# starts with the app's, and profiles of its own.
BUNDLES = {
  "Notebook" => APP_ID,
  "NotebookWidgets" => "#{APP_ID}.Widgets",
  "NotebookShare" => "#{APP_ID}.Share"
}.freeze
# The App Group the app and the share extension share (NOTEBOOK_APP_GROUP in Config/Shared.xcconfig), with the
# identifiers that have it.
APP_GROUP = "group.com.lukaskbl.Notebook"
APP_GROUP_BUNDLES = [APP_ID, "#{APP_ID}.Widgets", "#{APP_ID}.Share"].freeze
# Absolute paths, taken while loading: lanes run from other folders, and __dir__ is relative in a Fastfile.
HERE = File.expand_path(__dir__)
ROOT = File.expand_path("..", HERE)
PROJECT = File.join(ROOT, "Notebook.xcodeproj")
SCHEME = "Notebook"
OUTPUT = File.join(ROOT, "build", "fastlane")
METADATA = File.join(HERE, "metadata")
SCREENSHOTS = File.join(ROOT, "Design", "screenshots", "app-store")

# One app on two App Store platforms: how each is built and which screenshots belong to it. Both build the AppStore
# configuration: only it has the sandbox on the Mac and the entitlements for iCloud's key-value store and Time
# Sensitive notifications.
PLATFORMS = {
  ios: { name: "iPhone and iPad", sdk: "iphoneos", destination: "generic/platform=iOS", store: "ios", package: :ipa,
         screenshots: %w[iphone ipad], screenshot_tool: "app-store-screenshots.sh" },
  mac: { name: "Mac", sdk: "macosx", destination: "generic/platform=macOS", store: "osx", package: :pkg,
         screenshots: %w[mac], screenshot_tool: "mac-app-store-screenshots.sh" }
}.freeze
CONFIGURATION = "AppStore"

# fastlane/.env.secret holds the API key and the team. Values already in the environment win.
secrets = File.join(HERE, ".env.secret")
if File.exist?(secrets)
  File.foreach(secrets) do |line|
    key, value = line.strip.split("=", 2)
    next if key.to_s.empty? || key.start_with?("#") || value.nil?

    ENV[key] ||= value
  end
end

def secret(name)
  value = ENV[name].to_s
  UI.user_error!("#{name} is not set. Copy fastlane/.env.secret.example to fastlane/.env.secret and fill it in.") if value.empty?
  value
end

def api_key
  @api_key ||= app_store_connect_api_key(
    key_id: secret("APP_STORE_CONNECT_API_KEY_KEY_ID"),
    issuer_id: secret("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_filepath: File.expand_path(secret("APP_STORE_CONNECT_API_KEY_P8_PATH"))
  )
end

# Lets Xcode make the development profiles for the archive, signed in with the same API key. The team and the signing
# identity are given here rather than in Config/Local.xcconfig, which would sign the Debug builds for the team too.
# An archive signed for the App Store from the start (signs_for_store_from_start?) takes the Apple Distribution
# certificate instead, and no development profile.
def build_arguments(marketing_version, development: true)
  signing = if development
              ["-allowProvisioningUpdates",
               "-authenticationKeyPath", File.expand_path(secret("APP_STORE_CONNECT_API_KEY_P8_PATH")),
               "-authenticationKeyID", secret("APP_STORE_CONNECT_API_KEY_KEY_ID"),
               "-authenticationKeyIssuerID", secret("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
               "CODE_SIGN_IDENTITY=Apple Development"]
            else
              ["CODE_SIGN_STYLE=Manual", "CODE_SIGN_IDENTITY=Apple Distribution"]
            end
  [
    *signing,
    "DEVELOPMENT_TEAM=#{secret('DEVELOPMENT_TEAM')}",
    "MARKETING_VERSION=#{marketing_version}",
    "CURRENT_PROJECT_VERSION=#{build_number}"
  ].shelljoin
end

# GitHub gives every run a new Mac, which the team's development profiles don't list and which shouldn't become a
# device of the team on every run. There the Mac app is signed for the App Store from the start, with the profile and
# the certificate the export signs it with anyway.
def signs_for_store_from_start?(platform)
  platform == :mac && !ENV["CI"].to_s.empty?
end

# The App Store profiles of the app's and the extensions' targets, in Config/Local.xcconfig (gitignored), which only
# they read, each taking its own by its name: given to xcodebuild, one profile would go to every target, and to the
# Swift packages too, which take none.
def give_target_profiles(profiles)
  path = File.join(ROOT, "Config", "Local.xcconfig")
  lines = ["", "// From fastlane on GitHub: the Mac app and its extensions are signed for the App Store from the start."]
  BUNDLES.each { |target, identifier| lines << "NOTEBOOK_MAC_PROFILE_#{target} = #{profiles.fetch(identifier)}" }
  lines << "PROVISIONING_PROFILE_SPECIFIER[sdk=macosx*] = $(NOTEBOOK_MAC_PROFILE_$(TARGET_NAME))"
  File.write(path, (File.exist?(path) ? File.read(path) : "") + lines.join("\n") + "\n")
end

# The archive is signed for development; the export signs it for the App Store: with the team's Apple Distribution
# certificate in this Mac's keychain and App Store profiles, for the app and each extension, that fastlane makes or
# fetches with the API key. (The key may not use Apple's cloud-managed certificates, so Xcode can't do this part by
# itself.) The Mac's .pkg is signed with a Mac Installer Distribution certificate, which fastlane creates the first
# time; macOS then asks once whether xcodebuild may use its key. On GitHub that certificate comes from the secrets,
# since one made there would be a new one on every run. Returns the export options.
def store_signing(platform)
  folder = File.join(OUTPUT, "signing")
  register_this_mac if platform == :mac && !signs_for_store_from_start?(platform)
  register_extensions
  turn_on_capabilities
  profiles = BUNDLES.values.to_h do |identifier|
    # get_provisioning_profile would sign the profile with whatever certificate get_certificates handled last.
    lane_context.delete(SharedValues::CERT_CERTIFICATE_ID)
    get_provisioning_profile(api_key: api_key, app_identifier: identifier, platform: platform == :mac ? "macos" : "ios",
                             output_path: folder)
    check_app_group(identifier, lane_context[SharedValues::SIGH_PROFILE_PATH])
    check_icloud_container(lane_context[SharedValues::SIGH_PROFILE_PATH]) if identifier == APP_ID
    [identifier, lane_context[SharedValues::SIGH_NAME]]
  end
  if platform == :mac && !signs_for_store_from_start?(platform)
    get_certificates(api_key: api_key, platform: "macos", type: "mac_installer_distribution", output_path: folder)
    lane_context.delete(SharedValues::CERT_CERTIFICATE_ID)
  end
  installer = installer_certificate if platform == :mac
  options = {
    signingStyle: "manual",
    teamID: secret("DEVELOPMENT_TEAM"),
    signingCertificate: "Apple Distribution",
    provisioningProfiles: profiles,
    manageAppVersionAndBuildNumber: false
  }
  options[:installerSigningCertificate] = installer if platform == :mac
  options
end

# The name Xcode finds the Mac Installer Distribution certificate in the keychain by: the ones App Store Connect makes
# are still called "3rd Party Mac Developer Installer" there, and Xcode doesn't take the new name for them.
def installer_certificate
  name = sh("security find-identity -v 2>/dev/null", log: false)[/"(Mac Installer Distribution|3rd Party Mac Developer Installer)/, 1]
  UI.user_error!("No Mac Installer Distribution certificate in the keychain (on GitHub: MAC_INSTALLER_CERTIFICATE_P12).") if name.nil?
  name
end

# The extensions' bundle identifiers, registered with the team the first time one is built, for iPhone, iPad and the
# Mac, like the app's. turn_on_capabilities gives them what they need.
def register_extensions
  api_key
  BUNDLES.each do |target, identifier|
    next if identifier == APP_ID || Spaceship::ConnectAPI::BundleId.find(identifier)

    UI.message("Registering #{identifier}")
    Spaceship::ConnectAPI::BundleId.create(name: target, platform: "UNIVERSAL", identifier: identifier)
  end
end

# The entitlements ask for iCloud's key-value store (hidden folders and reminders go to your other devices through it),
# iCloud Documents in Notebook's own container (the earlier versions of notes) and Time Sensitive notifications
# (reminders get through a Focus), which the App ID must offer before a profile can carry them. Xcode turns them on by
# itself, but only while archiving, after the App Store profile was fetched, so the export would fail once. Turning
# them on here first makes the old profiles invalid, and get_provisioning_profile then makes new ones. iCloud is on
# with CloudKit support (XCODE_6), which is what lets the App ID have containers; the container itself is made and
# given to the App ID once on the developer website (check_icloud_container).
def turn_on_capabilities
  api_key
  bundle = Spaceship::ConnectAPI::BundleId.find(APP_ID)
  UI.user_error!("#{APP_ID} isn't an identifier of the team yet. Register it in the developer portal first.") if bundle.nil?
  types = Spaceship::ConnectAPI::BundleIdCapability::Type
  present = bundle.get_capabilities.map(&:capability_type)
  unless present.include?(types::ICLOUD)
    UI.message("Turning on iCloud for #{APP_ID}")
    bundle.create_capability(types::ICLOUD, settings: [{ key: "ICLOUD_VERSION", options: [{ key: "XCODE_6" }] }])
  end
  unless present.include?(types::USERNOTIFICATIONS_TIMESENSITIVE)
    UI.message("Turning on Time Sensitive notifications for #{APP_ID}")
    bundle.create_capability(types::USERNOTIFICATIONS_TIMESENSITIVE)
  end
  APP_GROUP_BUNDLES.each do |identifier|
    bundle = Spaceship::ConnectAPI::BundleId.find(identifier)
    next if bundle.nil? || bundle.get_capabilities.map(&:capability_type).include?(types::APP_GROUPS)

    UI.message("Turning on App Groups for #{identifier}")
    bundle.create_capability(types::APP_GROUPS)
  end
end

# The API key can turn App Groups on but can neither register the group nor give it to an identifier, so without that
# done once on the developer website (Design/app-store.md) the profile lacks it and the export would fail late with a
# message about entitlements. This says what to do instead, before anything is built.
def check_app_group(identifier, profile)
  return unless APP_GROUP_BUNDLES.include?(identifier)

  decoded = sh("security cms -D -i #{profile.shellescape} 2>/dev/null", log: false)
  groups = Plist.parse_xml(decoded)&.dig("Entitlements", "com.apple.security.application-groups") || []
  return if groups.include?(APP_GROUP)

  UI.user_error!("The profile for #{identifier} doesn't have the App Group #{APP_GROUP}. On developer.apple.com, " \
                 "register the group and give it to #{APP_GROUP_BUNDLES.join(', ')} (Design/app-store.md).")
end

# The App Store Connect API can neither make an iCloud container nor give it to an App ID, so that is done by hand,
# once (Design/app-store.md). A profile made before lacks the container, and the export would fail with an error that
# doesn't say why.
def check_icloud_container(profile_path)
  profile = Plist.parse_xml(sh(["security", "cms", "-D", "-i", profile_path].shelljoin, log: false))
  containers = profile&.dig("Entitlements", "com.apple.developer.icloud-container-identifiers") || []
  return if containers.include?(ICLOUD_CONTAINER)

  UI.user_error!("The profile for #{APP_ID} has no iCloud container #{ICLOUD_CONTAINER}, which version history needs. " \
                 "Make it and give it to the App ID on developer.apple.com, as Design/app-store.md says, then run this again.")
end

# The Mac's development profile, which the archive is signed with first, has to list this Mac. Building for "My Mac"
# in Xcode registers it with the team; an archive for any Mac doesn't, so this does (once; it's left alone after).
def register_this_mac
  udid = sh("system_profiler SPHardwareDataType", log: false)[/Provisioning UDID: (\S+)/, 1]
  return UI.important("This Mac's provisioning UDID is unknown; the archive may lack a development profile.") if udid.nil?

  register_device(api_key: api_key, platform: "mac", udid: udid, name: sh("scutil --get ComputerName", log: false).strip)
end

def version
  File.read(File.join(ROOT, "Config", "Shared.xcconfig"))[/^MARKETING_VERSION = (.+)$/, 1].strip
end

def git(*arguments)
  sh(["git", "-C", ROOT, *arguments].shelljoin, log: false).strip
end

# The version a TestFlight build is on its way to. Config/Shared.xcconfig holds the version of the latest release,
# which gets a v tag when it ships, so once v1.0.0 is tagged, the builds after it are the next minor version, 1.1.0.
# Before that they are 1.0.0 itself. (A version that is out is closed in App Store Connect: it takes no more builds.)
def beta_version
  @beta_version ||= if git("tag", "--list", "v#{version}").empty?
                      version
                    else
                      major, minor = version.split(".").map(&:to_i)
                      "#{major}.#{minor + 1}.0"
                    end
end

# Every upload needs a higher build number. It is the date and time in Germany, year first so that it sorts:
# 2026.1017.1047 is 17 October 2026 at 10:47. The same on this Mac and on GitHub, and for both platforms of one run.
def build_number
  @build_number ||= begin
    zone = ENV["TZ"]
    ENV["TZ"] = "Europe/Berlin"
    now = Time.now.localtime
    ENV["TZ"] = zone
    "#{now.year}.#{now.month * 100 + now.day}.#{now.hour * 100 + now.min}"
  end
end

# "What to Test" in TestFlight: the commit the build is made of, which the version and build number can't hold.
def what_to_test
  commit = git("rev-parse", "HEAD")
  text = "#{git('log', '-1', '--format=%s')}\n\n#{commit[0, 7]}"
  # On GitHub the build is the pushed commit, though setting up Ruby rewrites the checkout's .bundle/config.
  dirty = !ENV["CI"] && !git("status", "--porcelain", "--untracked-files=no").empty?
  text += " with changes that aren't committed" if dirty
  "#{text}\nhttps://github.com/lukaskaibel/notebook/commit/#{commit}"
end

# Archives one platform for the App Store and returns the .ipa or .pkg. TestFlight builds take beta_version.
def archive_for_store(platform, marketing_version: version)
  config = PLATFORMS.fetch(platform)
  folder = File.join(OUTPUT, platform.to_s)
  UI.header("#{config[:name]}: Notebook #{marketing_version} (#{build_number})")
  export_options = store_signing(platform)
  give_target_profiles(export_options[:provisioningProfiles]) if signs_for_store_from_start?(platform)
  package = build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: CONFIGURATION,
    # The target is for both platforms; the SDK tells gym which package to make (.ipa or .pkg).
    sdk: config[:sdk],
    destination: config[:destination],
    clean: true,
    archive_path: File.join(folder, "Notebook.xcarchive"),
    output_directory: folder,
    output_name: "Notebook",
    export_method: "app-store",
    export_options: export_options,
    skip_profile_detection: true,
    # gym hands these to the export as well, so they mustn't go into export_xcargs a second time.
    xcargs: build_arguments(marketing_version, development: !signs_for_store_from_start?(platform))
  )
  check_sandbox(File.join(folder, "Notebook.xcarchive")) if platform == :mac
  package
end

# The Mac App Store takes only sandboxed apps, and macOS runs only sandboxed extensions.
def check_sandbox(archive)
  app = Dir[File.join(archive, "Products", "Applications", "*.app")].first
  [app, *Dir[File.join(app, "Contents", "PlugIns", "*.appex")]].each do |bundle|
    entitlements = sh("codesign -d --entitlements - --xml #{bundle.shellescape} 2>/dev/null", log: false)
    sandboxed = Plist.parse_xml(entitlements)&.fetch("com.apple.security.app-sandbox", false)
    UI.user_error!("The archived #{File.basename(bundle)} is not sandboxed; not uploading it.") unless sandboxed == true
  end
end

# Uploads a build and waits until App Store Connect has processed it, which "What to Test" needs. The internal testers
# get every build by themselves, the external ones through send_to_external_testers.
def upload_beta(platform, package)
  config = PLATFORMS.fetch(platform)
  upload_to_testflight(
    api_key: api_key,
    app_platform: config[:store],
    config[:package] => package,
    # In the app's primary language, which a new app's builds don't have yet, and in any the builds have.
    localized_build_info: { "default" => { whats_new: what_to_test }, "en-US" => { whats_new: what_to_test } },
    distribute_external: false
  )
  send_to_external_testers(platform)
end

# The TestFlight group of testers outside the team, such as family, who get every build once Apple's Beta App Review
# has passed it, and what App Store Connect calls the platforms of its builds.
EXTERNAL_GROUP = "Family and friends"
CONNECT_PLATFORMS = { ios: "IOS", mac: "MAC_OS" }.freeze

# Adds the build just uploaded to EXTERNAL_GROUP and submits it for Beta App Review; TestFlight offers it to the group
# once Apple has passed it. The test information and the reviewer's contact are filled in on App Store Connect. pilot's
# own distribute_external isn't used: a refused submission (say while another build still waits for review) would fail
# an upload that went through, and its way around that expires the waiting build, which stops copies people installed.
# Here the build then stays with the internal testers.
def send_to_external_testers(platform)
  api_key
  build_name = "#{beta_version} (#{build_number})"
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  group = app.get_beta_groups.find { |candidate| candidate.name == EXTERNAL_GROUP }
  return UI.important("There's no TestFlight group \"#{EXTERNAL_GROUP}\"; only the team gets #{build_name}.") if group.nil?

  build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: beta_version, build_number: build_number,
                                           platform: CONNECT_PLATFORMS.fetch(platform)).first
  return UI.important("App Store Connect doesn't list #{build_name} yet; only the team gets it.") if build.nil?

  build.add_beta_groups(beta_groups: [group])
  return UI.message("#{build_name} is already submitted for Beta App Review.") unless build.ready_for_beta_submission?

  build.post_beta_app_review_submission
  UI.success("Submitted #{build_name} for Beta App Review; \"#{EXTERNAL_GROUP}\" gets it once Apple has passed it.")
rescue Spaceship::UnexpectedResponse, Spaceship::BasicPreferredInfoError => error
  UI.important("\"#{EXTERNAL_GROUP}\" doesn't get #{build_name}: #{error.message}")
end

def upload_to_beta(platform)
  upload_beta(platform, archive_for_store(platform, marketing_version: beta_version))
end

def flag(value)
  value == true || value.to_s == "true"
end

# deliver wants one folder per language and tells the devices apart by the size of each picture. The prefix keeps
# iPhone and iPad apart and the numbers keep the order.
def stage_screenshots(platform)
  staged = File.join(OUTPUT, "screenshots", platform.to_s)
  FileUtils.rm_rf(staged)
  language = File.join(staged, "en-US")
  FileUtils.mkdir_p(language)
  PLATFORMS.fetch(platform)[:screenshots].each do |device|
    pictures = Dir[File.join(SCREENSHOTS, device, "*.png")].sort
    UI.user_error!("No screenshots in #{File.join(SCREENSHOTS, device)}; run `bundle exec fastlane screenshots`.") if pictures.empty?
    pictures.each { |picture| FileUtils.cp(picture, File.join(language, "#{device}-#{File.basename(picture)}")) }
  end
  staged
end

# The contact for App Review comes from fastlane/.env.secret, since the repository is public. The notes are in
# fastlane/metadata/review_information/notes.txt, which deliver adds by itself.
def review_contact(required: false)
  names = %w[REVIEW_FIRST_NAME REVIEW_LAST_NAME REVIEW_PHONE REVIEW_EMAIL]
  names.each { |name| secret(name) } if required
  {
    first_name: ENV["REVIEW_FIRST_NAME"],
    last_name: ENV["REVIEW_LAST_NAME"],
    phone_number: ENV["REVIEW_PHONE"],
    email_address: ENV["REVIEW_EMAIL"]
  }.reject { |_, value| value.to_s.empty? }
end

# App Store Connect changes the notes for App Review only together with a whole contact. Without one in
# fastlane/.env.secret, the notes already there stay as they are and the other texts go up.
def metadata_for(contact)
  return METADATA if contact.size == 4

  UI.important("No App Review contact in fastlane/.env.secret (REVIEW_*): the review notes in App Store Connect stay as they are.")
  staged = File.join(OUTPUT, "metadata")
  FileUtils.rm_rf(staged)
  FileUtils.cp_r(METADATA, staged)
  FileUtils.rm_rf(File.join(staged, "review_information"))
  staged
end

# Makes sure the platform has this version in App Store Connect to fill in, as deliver would. While an earlier version
# of either platform is in review or waits to be released, App Store Connect keeps the app's name, which both platforms
# share, locked, so this stops with the reason instead of failing halfway through the upload.
def prepare_store_version(platform)
  api_key
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  waiting = app.get_app_store_versions.find do |candidate|
    candidate.version_string != version && %w[WAITING_FOR_REVIEW IN_REVIEW PENDING_DEVELOPER_RELEASE].include?(candidate.app_store_state)
  end
  if waiting
    name = PLATFORMS.values.find { |config| Spaceship::ConnectAPI::Platform.map(config[:store]) == waiting.platform }&.fetch(:name)
    UI.user_error!("#{name || waiting.platform} #{waiting.version_string} is #{waiting.app_store_state.downcase.tr('_', ' ')}. " \
                   "Release it, or remove it from review, in App Store Connect before uploading #{version}.")
  end
  app.ensure_version!(version, platform: Spaceship::ConnectAPI::Platform.map(PLATFORMS.fetch(platform)[:store]))
  app
end

# Texts, age rating, review notes and screenshots of one platform, with its new build when there is one. Without
# `screenshots`, the screenshots already in App Store Connect stay as they are.
def store_upload(platform, package: nil, submit: false, automatic_release: false, screenshots: true)
  config = PLATFORMS.fetch(platform)
  UI.header("#{config[:name]}: App Store #{version}")
  prepare_store_version(platform)
  contact = review_contact(required: submit)
  options = {
    api_key: api_key,
    platform: config[:store],
    app_version: version,
    metadata_path: metadata_for(contact),
    skip_screenshots: !screenshots,
    app_rating_config_path: File.join(HERE, "rating.json"),
    app_review_information: contact,
    skip_binary_upload: package.nil?,
    submit_for_review: submit,
    automatic_release: automatic_release,
    # No encryption of its own (ITSAppUsesNonExemptEncryption is NO). The app shows the user's own files, and the
    # sample notes, pictures and drawing are made by the app itself.
    submission_information: {
      export_compliance_uses_encryption: false,
      content_rights_contains_third_party_content: false
    },
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false
  }
  options.merge!(screenshots_path: stage_screenshots(platform), overwrite_screenshots: true) if screenshots
  options[config[:package]] = package if package
  upload_to_app_store(options)
end

def release(platform, options)
  package = archive_for_store(platform)
  store_upload(platform, package: package, submit: options[:submit].nil? || flag(options[:submit]),
                         automatic_release: flag(options[:automatic_release]))
end

desc "Takes the App Store screenshots of the iPhone, iPad and Mac apps on the sample notes"
lane :screenshots do
  PLATFORMS.each_value { |config| sh(File.join(ROOT, "Tools", config[:screenshot_tool])) }
end

desc "Uploads the texts, the age rating and the screenshots of the Mac, iPhone and iPad apps"
desc "screenshots:false uploads the texts alone, leaving the screenshots in App Store Connect as they are"
lane :metadata do |options|
  PLATFORMS.each_key { |platform| store_upload(platform, screenshots: options[:screenshots].nil? || flag(options[:screenshots])) }
end

desc "Builds the Mac, iPhone and iPad apps for the App Store, signed, without uploading them"
lane :build do
  PLATFORMS.each_key { |platform| archive_for_store(platform) }
end

desc "Builds the Mac, iPhone and iPad apps and uploads them to TestFlight"
lane :beta do
  PLATFORMS.each_key { |platform| upload_to_beta(platform) }
end

desc "Submits the newest uploaded builds of the Mac, iPhone and iPad apps for review, with texts and screenshots"
desc "Builds nothing: run it after `beta` once the TestFlight builds are tested. automatic_release:true as for release"
lane :submit do |options|
  PLATFORMS.each_key { |platform| store_upload(platform, submit: true, automatic_release: flag(options[:automatic_release])) }
end

desc "Builds the Mac, iPhone and iPad apps, uploads them with texts and screenshots and submits them for review"
desc "submit:false stops before the submission, automatic_release:true releases them as soon as they are approved"
lane :release do |options|
  PLATFORMS.each_key { |platform| release(platform, options) }
end

# The creative assets of iOS 27 and the app previews, which deliver can't upload: made by Tools/app-store-media.sh and
# Tools/app-store-previews.sh (iPhone, iPad) and Tools/mac-app-store-preview.sh, and where each goes. Each is placed on
# the version's English page in place of what that placement shows now. `frame` is the poster, the frame the App Store
# shows before the video plays: hours:minutes:seconds:frames, or seconds before the end (the header's finished lines).
STORE_MEDIA = [
  { file: "Design/screenshots/app-store/creative/header.mp4", platform: "IOS", type: "PRODUCT_PAGE_HEADER_ASSET",
    group: "DEFAULT_PROFILE", category: "CREATIVE_ASSETS", frame: -1.5, name: "Header: typing in a note" },
  { file: "Design/screenshots/app-store/creative/search.mp4", platform: "IOS", type: "APP_STORE_SEARCH_RESULTS_ASSET",
    group: "DEFAULT_PROFILE", category: "CREATIVE_ASSETS", frame: "00:00:04:00", name: "Search: a note among its files" },
  { file: "build/app-store-media/previews/iphone.mp4", platform: "IOS", type: "APP_PREVIEW",
    group: "IPHONE_DYNAMIC_ISLAND_LARGE_PROFILE", category: "APP_SCREENSHOTS_AND_PREVIEWS", frame: "00:00:05:00",
    name: "iPhone preview" },
  { file: "build/app-store-media/previews/ipad.mp4", platform: "IOS", type: "APP_PREVIEW", group: "IPAD_13_PROFILE",
    category: "APP_SCREENSHOTS_AND_PREVIEWS", frame: "00:00:02:00", name: "iPad preview" },
  { file: "build/app-store-media/previews/mac.mp4", platform: "MAC_OS", type: "APP_PREVIEW", group: "MAC_PROFILE",
    category: "APP_SCREENSHOTS_AND_PREVIEWS", frame: "00:00:02:00", name: "Mac preview" }
].freeze

def api_token
  Spaceship::ConnectAPI::Token.create(key_id: secret("APP_STORE_CONNECT_API_KEY_KEY_ID"),
                                      issuer_id: secret("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
                                      filepath: File.expand_path(secret("APP_STORE_CONNECT_API_KEY_P8_PATH")))
end

desc "Checks the header, the search result and the app previews against App Store Connect's specs, says where they'd go"
desc "upload:true uploads them to the app's Asset Library and places them on this version (version:1.2.0 for another)"
lane :store_media do |options|
  library = AssetLibrary.new(api_token, APP_ID, dry_run: !flag(options[:upload]))
  target = options[:version] || version
  UI.message(library.dry_run? ? "Dry run: nothing is uploaded or changed." : "Uploading to App Store Connect.")
  missing = []
  STORE_MEDIA.each do |media|
    file = File.join(ROOT, media[:file])
    unless File.exist?(file)
      missing << media[:file]
      next
    end
    spec = library.check_video(file, media[:type], media[:group])
    localization, where = library.localization(media[:platform], target, "en-US")
    UI.message("#{media[:name]}: #{media[:file]} fits #{spec['shortName']}; " +
               (localization ? "it goes on #{where}" : "nowhere to place it yet: #{where}"))
    UI.user_error!("Nowhere to put #{media[:name]}: #{where}.") if localization.nil? && !library.dry_run?
    video = library.upload_video(file, category: media[:category], name: media[:name], frame: media[:frame])
    library.place(video, media[:type], media[:group], localization) if localization
  end
  UI.user_error!("Missing: #{missing.join(', ')}. Make them first (see Design/app-store.md).") if missing.any? && !library.dry_run?
  UI.important("Not made yet: #{missing.join(', ')}") if missing.any?
end

platform :ios do
  desc "Takes the iPhone and iPad screenshots"
  lane(:screenshots) { sh(File.join(ROOT, "Tools", PLATFORMS[:ios][:screenshot_tool])) }

  desc "Uploads the texts, the age rating and the screenshots of the iPhone and iPad app"
  lane(:metadata) { |options| store_upload(:ios, screenshots: options[:screenshots].nil? || flag(options[:screenshots])) }

  desc "Builds the iPhone and iPad app for the App Store, signed, without uploading it"
  lane(:build) { archive_for_store(:ios) }

  desc "Builds the iPhone and iPad app and uploads it to TestFlight"
  lane(:beta) { upload_to_beta(:ios) }

  desc "Submits the newest uploaded build of the iPhone and iPad app for review, with texts and screenshots"
  lane(:submit) { |options| store_upload(:ios, submit: true, automatic_release: flag(options[:automatic_release])) }

  desc "Builds the iPhone and iPad app, uploads it with texts and screenshots and submits it for review"
  lane(:release) { |options| release(:ios, options) }
end

